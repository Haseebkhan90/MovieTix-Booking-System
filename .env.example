# Local emulators — no Firebase keys needed
VITE_USE_EMULATORS=true
VITE_FIREBASE_PROJECT_ID=demo-movietix

# Production (Firebase console → Project settings → Your apps → npm)
# Copy these into .env.local and set VITE_USE_EMULATORS=false
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=

# Optional: seed the real project (Project settings → Service accounts → Generate new private key)
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json
# FORCE_SEED=1
