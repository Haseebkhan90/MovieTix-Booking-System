{
  "name": "movietix",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "firebase emulators:exec --project demo-movietix --only auth,firestore \"npm run seed && vite\"",
    "dev:web": "vite",
    "emu": "firebase emulators:start --project demo-movietix --only auth,firestore",
    "seed": "tsx scripts/seedFirestore.ts",
    "seed:force": "FORCE_SEED=1 tsx scripts/seedFirestore.ts",
    "build": "vite build",
    "lint": "eslint src",
    "preview": "vite preview",
    "deploy": "npm run build && firebase deploy --only hosting,firestore"
  },
  "dependencies": {
    "firebase": "^12.4.0",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.22.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/node": "26.4.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "firebase-admin": "^13.5.0",
    "firebase-tools": "^14.24.0",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.13",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2"
  }
}
