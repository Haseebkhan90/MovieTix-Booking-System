rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isStaff() {
      return signedIn() && request.auth.token.role in ['STAFF', 'MANAGER', 'TENANT_ADMIN', 'PLATFORM_ADMIN'];
    }

    function isAdmin() {
      return signedIn() && request.auth.token.role == 'PLATFORM_ADMIN';
    }

    match /movies/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /cinemas/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /tenants/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /shows/{showId} {
      allow read: if true;
      allow create, delete: if isStaff();
      allow update: if isStaff()
        || (signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['soldCount'])
          && request.resource.data.soldCount is int
          && request.resource.data.soldCount >= resource.data.soldCount);
    }

    match /shows/{showId}/seats/{seatId} {
      function heldByMe() {
        return resource.data.status == 'held' && resource.data.holdUserId == request.auth.uid;
      }
      function expiredHold() {
        return resource.data.status == 'held' && resource.data.holdUntil < request.time.toMillis();
      }

      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.status == 'held'
        && request.resource.data.holdUserId == request.auth.uid;
      allow update: if signedIn() && (
        isStaff()
        || heldByMe()
        || (expiredHold() && request.resource.data.status == 'held'
            && request.resource.data.holdUserId == request.auth.uid)
      );
      allow delete: if signedIn() && (isStaff() || heldByMe() || expiredHold());
    }

    match /bookings/{id} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isStaff());
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isStaff();
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isStaff());
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'CUSTOMER';
      allow update: if isStaff()
        || (signedIn()
          && request.auth.uid == uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.tenantId == resource.data.tenantId);
    }

    match /promoCodes/{id} {
      allow read: if signedIn();
      allow write: if isStaff();
    }
  }
}
